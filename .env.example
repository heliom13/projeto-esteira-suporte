# ==========================================================
# Esteira Suporte — variaveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
#   cp .env.example .env
# ==========================================================

# ===== Banco de dados (Postgres) =====
POSTGRES_DB=esteira
POSTGRES_USER=esteira
POSTGRES_PASSWORD=TROQUE_esta_senha

# ===== Backend =====
# Chave JWT — gere uma forte com:  openssl rand -base64 48
JWT_SECRET=TROQUE_por_uma_chave_forte_e_unica
# Validade do login em milissegundos (7200000 = 2 horas)
JWT_EXPIRATION_MS=7200000
# Origens liberadas no CORS = o endereco do frontend.
# Local: http://localhost:3000  | Producao: https://seu-dominio.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Token que protege a fila de WhatsApp (a extensao usa o mesmo)
WHATSAPP_QUEUE_TOKEN=TROQUE_este_token
# E-mail transacional (Resend) — opcional; deixe em branco para nao enviar e-mail
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Suporte Imobiliario <onboarding@resend.dev>
# URL do frontend (usada em links dentro dos e-mails)
APP_FRONT_URL=http://localhost:3000
# Token generico de mensagens
TOKEN_MESSAGE=token

# ===== Frontend =====
# Endereco do backend acessivel PELO NAVEGADOR do usuario.
# Local: http://localhost:8080  | Producao: https://api.seu-dominio.com
# OBS: ao mudar isto, reconstrua o frontend (docker compose build frontend).
REACT_APP_API_URL=http://localhost:8080
